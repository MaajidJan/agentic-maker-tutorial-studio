# Google Gemini API Key (Mandatory)
GEMINI_API_KEY=your_gemini_api_key_here

# Target Gemini Foundation Model
GEMINI_MODEL=gemini-3.5-flash

# Google Cloud Project ID (Optional - for Cloud Run deployment & Firestore)
GOOGLE_CLOUD_PROJECT=your_gcp_project_id
USE_FIRESTORE=false

# Optional: Freesound API Key (for CC-licensed sound downloads from freesound.org)
# If omitted or left empty, the built-in procedural 44.1kHz audio synthesis engine generates all sound cues automatically!
FREESOUND_API_KEY=
